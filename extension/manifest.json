{
  "manifest_version": 3,
  "name": "DOM Modifier",
  "version": "13.37",
  "description": "Modify the DOM on reactive websites",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "scripts/dragDrop/dropzone.js",
        "scripts/dragDrop/drag/dragConversation.js",
        "scripts/dragDrop/drag/dragFolder.js",
        "scripts/dragDrop/drop/dropConversation.js",
        "scripts/dragDrop/drop/dropFolder.js",

        "scripts/popups/popup.js",
        "scripts/popups/conversationOptions.js",
        "scripts/popups/folderOptions.js",
        "scripts/popups/conversationMenu.js",
        "scripts/popups/folderMenu.js",

        "scripts/api/api.js",
        "scripts/api/getData.js",
        "scripts/api/postData.js",
        "scripts/api/deleteData.js",

        "scripts/foldersNode/foldersNode.js",
        "scripts/foldersNode/folderNode.js",
        "scripts/foldersNode/conversationNode.js",

        "scripts/startup/appendButtons.js",
        "scripts/startup/appendFolders.js",
        "content.js"
      ],
      "css": [
        "styles/global.css",
        "styles/startup.css",
        "styles/options.css",
        "styles/folders.css",
        "styles/folderMenu.css",
        "styles/conversationMenu.css"
      ],
      "type": "module",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["*://*/*"]
}
