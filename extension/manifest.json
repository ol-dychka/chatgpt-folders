{
  "manifest_version": 3,
  "name": "DOM Modifier",
  "version": "13.37",
  "description": "Modify the DOM on reactive websites",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "scripts/drag/dropzone.js",
        "scripts/drag/drag.js",
        "scripts/drag/helpers.js",
        "scripts/drag/dropChat.js",
        "scripts/drag/dropFolder.js",

        "scripts/popups/popup.js",
        "scripts/popups/chatOptions.js",
        "scripts/popups/folderOptions.js",
        "scripts/popups/folderMenu.js",
        "scripts/popups/chatMenu.js",

        "scripts/api/api.js",
        "scripts/api/getData.js",
        "scripts/api/postData.js",
        "scripts/api/deleteData.js",

        "scripts/sidebar/foldersNode.js",
        "scripts/sidebar/folderNode.js",
        "scripts/sidebar/conversationNode.js",

        "scripts/startup/appendButtons.js",
        "scripts/startup/appendFolders.js",
        "content.js"
      ],
      "css": ["style.css"],
      "type": "module",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["*://*/*"]
}
