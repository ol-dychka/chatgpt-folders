{
  "manifest_version": 3,
  "name": "DOM Modifier",
  "version": "1.0",
  "description": "Modify the DOM on reactive websites",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["scripts/folders.js", "scripts/startup.js", "content.js"],
      "type": "module",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
